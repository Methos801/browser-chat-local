# Anthropic API key (optional — only needed to chat with the real Anthropic cloud API).
# Local servers (oMLX / Ollama / LM Studio) do NOT need a key.
ANTHROPIC_API_KEY=

# Built-in Tavily web-search key (optional — only needed if you enable the Tavily MCP).
TAVILY_API_KEY=

# Default port oMLX listens on (matches the oMLX server's OMLX_PORT). Default: 8000.
OMLX_PORT=8000
